root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,mk}]
indent_style = tab
indent_size = 4
tab_width = 4

[Makefile]
indent_style = tab

[*.janet]
indent_style = space
indent_size = 2

[*.{js,mjs,html}]
indent_style = space
indent_size = 4
