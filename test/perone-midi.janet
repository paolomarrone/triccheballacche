# Two MIDI-only effects, automation, then an ABI 2 instrument.
(def keys (daw/midi :keys))
(def first (daw/plugin "build/test/midi.perone"))
(def second (daw/plugin "build/test/midi.perone" {:transpose 0 :delay 11}))
(def synth (daw/plugin "build/test/fixture.perone" {:gain 0.25}))
(daw/midi-through keys first)
(daw/midi-through first second)
(daw/midi-through second synth)
(daw/output synth)
(daw/midi-output second)
(daw/note keys 0.001 0.003 60 100)
(daw/midi-event keys 0.009 [0xc2 12])
(daw/param first 0.01 :delay 13)
(daw/param first 0.01 :transpose -12)
(daw/note keys 0.011 0.004 65 90)
(daw/end 0.03)
